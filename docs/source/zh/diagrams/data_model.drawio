<mxfile host="app.diagrams.net" modified="2026-04-02" agent="Claude" version="24.0">
  <diagram id="datamodel" name="核心数据模型">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="&lt;b&gt;核心数据模型 (node_schema.py)&lt;/b&gt;" style="text;html=1;fontSize=18;align=center;" vertex="1" parent="1">
          <mxGeometry x="400" y="10" width="500" height="35" as="geometry"/>
        </mxCell>

        <!-- ====== 第一行: 主数据流转模型 ====== -->
        <mxCell id="row1-label" value="&lt;b&gt;数据流转路径&lt;/b&gt;: Media &amp;rarr; Clip &amp;rarr; GroupClips &amp;rarr; GroupScript &amp;rarr; Voiceover &amp;rarr; BGM &amp;rarr; TimelineTracks &amp;rarr; MP4" style="text;html=1;fontSize=10;fontColor=#666;align=left;" vertex="1" parent="1">
          <mxGeometry x="30" y="50" width="800" height="20" as="geometry"/>
        </mxCell>

        <!-- Media -->
        <mxCell id="m-media-h" value="&lt;b&gt;Media (素材)&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#4A90D9;fontColor=#fff;strokeColor=none;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="30" y="80" width="180" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="m-media-b" value="&lt;font style=&quot;font-family:monospace;font-size:10px&quot;&gt;media_id: str&lt;br&gt;path: str&lt;br&gt;type: &quot;video&quot; | &quot;image&quot;&lt;br&gt;metadata: VideoMetadata&lt;br&gt;extra_info: dict&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EBF0FA;fontColor=#333;strokeColor=#4A90D9;align=left;spacingLeft=8;verticalAlign=top;spacingTop=5;" vertex="1" parent="1">
          <mxGeometry x="30" y="110" width="180" height="90" as="geometry"/>
        </mxCell>

        <!-- Clip -->
        <mxCell id="m-clip-h" value="&lt;b&gt;Clip (片段)&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#5B7FD6;fontColor=#fff;strokeColor=none;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="250" y="80" width="180" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="m-clip-b" value="&lt;font style=&quot;font-family:monospace;font-size:10px&quot;&gt;clip_id: str&lt;br&gt;caption: str (VLM 描述)&lt;br&gt;path: str&lt;br&gt;source_ref: SourceRef&lt;br&gt;fps: float&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EBF0FA;fontColor=#333;strokeColor=#5B7FD6;align=left;spacingLeft=8;verticalAlign=top;spacingTop=5;" vertex="1" parent="1">
          <mxGeometry x="250" y="110" width="180" height="90" as="geometry"/>
        </mxCell>

        <!-- GroupClips -->
        <mxCell id="m-group-h" value="&lt;b&gt;GroupClips (分组)&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#8E4CCD;fontColor=#fff;strokeColor=none;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="470" y="80" width="180" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="m-group-b" value="&lt;font style=&quot;font-family:monospace;font-size:10px&quot;&gt;group_id: str&lt;br&gt;summary: str (段落摘要)&lt;br&gt;clip_ids: List[str]&lt;br&gt;  (有序片段列表)&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F3E5F5;fontColor=#333;strokeColor=#8E4CCD;align=left;spacingLeft=8;verticalAlign=top;spacingTop=5;" vertex="1" parent="1">
          <mxGeometry x="470" y="110" width="180" height="90" as="geometry"/>
        </mxCell>

        <!-- GroupScript -->
        <mxCell id="m-script-h" value="&lt;b&gt;GroupScript (文案)&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#9F3BCA;fontColor=#fff;strokeColor=none;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="690" y="80" width="180" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="m-script-b" value="&lt;font style=&quot;font-family:monospace;font-size:10px&quot;&gt;group_id: str&lt;br&gt;raw_text: str (完整文案)&lt;br&gt;subtitle_units:&lt;br&gt;  List[SubtitleUnit]&lt;br&gt;  (分句字幕列表)&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F3E5F5;fontColor=#333;strokeColor=#9F3BCA;align=left;spacingLeft=8;verticalAlign=top;spacingTop=5;" vertex="1" parent="1">
          <mxGeometry x="690" y="110" width="180" height="90" as="geometry"/>
        </mxCell>

        <!-- Voiceover -->
        <mxCell id="m-voice-h" value="&lt;b&gt;Voiceover (配音)&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#B02AC7;fontColor=#fff;strokeColor=none;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="910" y="80" width="180" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="m-voice-b" value="&lt;font style=&quot;font-family:monospace;font-size:10px&quot;&gt;group_id: str&lt;br&gt;voiceover_id: str&lt;br&gt;path: str (WAV 文件)&lt;br&gt;duration: int (毫秒)&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F3E5F5;fontColor=#333;strokeColor=#B02AC7;align=left;spacingLeft=8;verticalAlign=top;spacingTop=5;" vertex="1" parent="1">
          <mxGeometry x="910" y="110" width="180" height="90" as="geometry"/>
        </mxCell>

        <!-- BGM -->
        <mxCell id="m-bgm-h" value="&lt;b&gt;BGM (背景音乐)&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#C119C4;fontColor=#fff;strokeColor=none;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1130" y="80" width="180" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="m-bgm-b" value="&lt;font style=&quot;font-family:monospace;font-size:10px&quot;&gt;bgm_id: str&lt;br&gt;path: str&lt;br&gt;duration: int (毫秒)&lt;br&gt;bpm: float (每分钟拍数)&lt;br&gt;beats: List[int]&lt;br&gt;  (鼓点时间戳列表, ms)&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F3E5F5;fontColor=#333;strokeColor=#C119C4;align=left;spacingLeft=8;verticalAlign=top;spacingTop=5;" vertex="1" parent="1">
          <mxGeometry x="1130" y="110" width="180" height="105" as="geometry"/>
        </mxCell>

        <!-- 第一行箭头 -->
