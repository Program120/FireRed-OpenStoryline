        <!-- 引用关系虚线 -->
        <mxCell id="ref1" value="&lt;font style=&quot;font-size:8px&quot; color=&quot;#999&quot;&gt;引用&lt;/font&gt;" style="strokeColor=#CCC;strokeWidth=1;dashed=1;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="m-sr-h" target="m-clip-b">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="ref2" value="&lt;font style=&quot;font-size:8px&quot; color=&quot;#999&quot;&gt;引用&lt;/font&gt;" style="strokeColor=#CCC;strokeWidth=1;dashed=1;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="m-tw-h" target="m-ct-b">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="ref3" value="&lt;font style=&quot;font-size:8px&quot; color=&quot;#999&quot;&gt;引用&lt;/font&gt;" style="strokeColor=#CCC;strokeWidth=1;dashed=1;exitX=0.5;exitY=0;entryX=0.3;entryY=1;" edge="1" parent="1" source="m-vm-h" target="m-media-b">
