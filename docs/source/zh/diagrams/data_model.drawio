        <!-- SourceRef -->
        <mxCell id="m-sr-h" value="&lt;b&gt;SourceRef (素材引用)&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#D4A843;fontColor=#fff;strokeColor=none;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="30" y="445" width="200" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="m-sr-b" value="&lt;font style=&quot;font-family:monospace;font-size:10px&quot;&gt;media_id: str (来源素材)&lt;br&gt;start: int (起始毫秒)&lt;br&gt;end: int (结束毫秒)&lt;br&gt;duration: int (时长毫秒)&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF8E1;fontColor=#333;strokeColor=#D4A843;align=left;spacingLeft=8;verticalAlign=top;spacingTop=5;" vertex="1" parent="1">
          <mxGeometry x="30" y="475" width="200" height="75" as="geometry"/>
        </mxCell>

        <!-- TimeWindow -->
        <mxCell id="m-tw-h" value="&lt;b&gt;TimeWindow (时间窗口)&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#50B86C;fontColor=#fff;strokeColor=none;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="270" y="445" width="200" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="m-tw-b" value="&lt;font style=&quot;font-family:monospace;font-size:10px&quot;&gt;start: int (起始毫秒)&lt;br&gt;end: int (结束毫秒)&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#999&quot;&gt;时间线上的一个区间&lt;br&gt;被 ClipTrack / SubtitleTrack 等引用&lt;/font&gt;&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8F5E9;fontColor=#333;strokeColor=#50B86C;align=left;spacingLeft=8;verticalAlign=top;spacingTop=5;" vertex="1" parent="1">
          <mxGeometry x="270" y="475" width="200" height="95" as="geometry"/>
        </mxCell>

        <!-- VideoMetadata -->
        <mxCell id="m-vm-h" value="&lt;b&gt;VideoMetadata (视频元数据)&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#95A5A6;fontColor=#fff;strokeColor=none;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="510" y="445" width="220" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="m-vm-b" value="&lt;font style=&quot;font-family:monospace;font-size:10px&quot;&gt;fps: float (帧率)&lt;br&gt;width: int (宽度)&lt;br&gt;height: int (高度)&lt;br&gt;duration: float (秒)&lt;br&gt;audio_sample_rate: int&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;fontColor=#333;strokeColor=#95A5A6;align=left;spacingLeft=8;verticalAlign=top;spacingTop=5;" vertex="1" parent="1">
          <mxGeometry x="510" y="475" width="220" height="90" as="geometry"/>
        </mxCell>

        <!-- SubtitleUnit -->
        <mxCell id="m-su-h" value="&lt;b&gt;SubtitleUnit (字幕单元)&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8833A;fontColor=#fff;strokeColor=none;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="770" y="445" width="200" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="m-su-b" value="&lt;font style=&quot;font-family:monospace;font-size:10px&quot;&gt;unit_id: str&lt;br&gt;index_in_group: int&lt;br&gt;text: str (单句文字)&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF3E0;fontColor=#333;strokeColor=#E8833A;align=left;spacingLeft=8;verticalAlign=top;spacingTop=5;" vertex="1" parent="1">
          <mxGeometry x="770" y="475" width="200" height="60" as="geometry"/>
        </mxCell>

        <!-- NodeMeta -->
        <mxCell id="m-nm-h" value="&lt;b&gt;NodeMeta (节点元数据)&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#7B68EE;fontColor=#fff;strokeColor=none;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1010" y="445" width="220" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="m-nm-b" value="&lt;font style=&quot;font-family:monospace;font-size:10px&quot;&gt;name: str (工具名称)&lt;br&gt;node_id: str (唯一标识)&lt;br&gt;node_kind: str (类别)&lt;br&gt;require_prior_kind: List&lt;br&gt;  (前置依赖类别列表)&lt;br&gt;next_available_node: List&lt;br&gt;  (可跳转的下游节点)&lt;br&gt;priority: int (优先级)&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EDE7F6;fontColor=#333;strokeColor=#7B68EE;align=left;spacingLeft=8;verticalAlign=top;spacingTop=5;" vertex="1" parent="1">
