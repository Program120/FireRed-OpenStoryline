        <mxCell id="arr5" style="strokeColor=#95A5A6;strokeWidth=2;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="1090" y="140" as="sourcePoint"/><mxPoint x="1130" y="140" as="targetPoint"/></mxGeometry>
        </mxCell>

        <!-- ====== 第二行: 时间线相关模型 ====== -->
        <mxCell id="row2-label" value="&lt;b&gt;时间线模型&lt;/b&gt;: 所有数据汇聚到 TimelineTracks，描述最终视频的四轨结构" style="text;html=1;fontSize=10;fontColor=#666;align=left;" vertex="1" parent="1">
          <mxGeometry x="30" y="235" width="600" height="20" as="geometry"/>
        </mxCell>

        <!-- TimelineTracks -->
        <mxCell id="m-tl-h" value="&lt;b&gt;TimelineTracks (时间线)&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#D208C1;fontColor=#fff;strokeColor=none;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="30" y="265" width="280" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="m-tl-b" value="&lt;font style=&quot;font-family:monospace;font-size:10px&quot;&gt;video: List[ClipTrack]       (视频轨)&lt;br&gt;subtitles: List[SubtitleTrack] (字幕轨)&lt;br&gt;voiceover: List[VoiceoverTrack] (配音轨)&lt;br&gt;bgm: List[BgmTrack]          (音乐轨)&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FCE4EC;fontColor=#333;strokeColor=#D208C1;align=left;spacingLeft=8;verticalAlign=top;spacingTop=5;" vertex="1" parent="1">
          <mxGeometry x="30" y="295" width="280" height="80" as="geometry"/>
        </mxCell>

        <!-- ClipTrack -->
        <mxCell id="m-ct-h" value="&lt;b&gt;ClipTrack (视频轨项)&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E74C3C;fontColor=#fff;strokeColor=none;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="350" y="265" width="220" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="m-ct-b" value="&lt;font style=&quot;font-family:monospace;font-size:10px&quot;&gt;clip_id: str&lt;br&gt;source_window: TimeWindow&lt;br&gt;  (素材中的截取区间)&lt;br&gt;timeline_window: TimeWindow&lt;br&gt;  (在最终时间线上的位置)&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FDEDEC;fontColor=#333;strokeColor=#E74C3C;align=left;spacingLeft=8;verticalAlign=top;spacingTop=5;" vertex="1" parent="1">
          <mxGeometry x="350" y="295" width="220" height="90" as="geometry"/>
        </mxCell>

        <!-- SubtitleTrack -->
        <mxCell id="m-st-h" value="&lt;b&gt;SubtitleTrack (字幕轨项)&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8833A;fontColor=#fff;strokeColor=none;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="610" y="265" width="220" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="m-st-b" value="&lt;font style=&quot;font-family:monospace;font-size:10px&quot;&gt;text: str (字幕文字)&lt;br&gt;timeline_window: TimeWindow&lt;br&gt;  (显示起止时间)&lt;br&gt;style: TextStyle (可选)&lt;br&gt;  (字体/颜色/描边等)&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF3E0;fontColor=#333;strokeColor=#E8833A;align=left;spacingLeft=8;verticalAlign=top;spacingTop=5;" vertex="1" parent="1">
          <mxGeometry x="610" y="295" width="220" height="90" as="geometry"/>
        </mxCell>

        <!-- VoiceoverTrack -->
        <mxCell id="m-vt-h" value="&lt;b&gt;VoiceoverTrack (配音轨项)&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#B02AC7;fontColor=#fff;strokeColor=none;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="870" y="265" width="220" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="m-vt-b" value="&lt;font style=&quot;font-family:monospace;font-size:10px&quot;&gt;media_id: str (配音文件 ID)&lt;br&gt;timeline_window: TimeWindow&lt;br&gt;  (播放起止时间)&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F3E5F5;fontColor=#333;strokeColor=#B02AC7;align=left;spacingLeft=8;verticalAlign=top;spacingTop=5;" vertex="1" parent="1">
          <mxGeometry x="870" y="295" width="220" height="65" as="geometry"/>
        </mxCell>

        <!-- BgmTrack -->
        <mxCell id="m-bt-h" value="&lt;b&gt;BgmTrack (音乐轨项)&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#C119C4;fontColor=#fff;strokeColor=none;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1130" y="265" width="220" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="m-bt-b" value="&lt;font style=&quot;font-family:monospace;font-size:10px&quot;&gt;bgm_id: str&lt;br&gt;timeline_window: TimeWindow&lt;br&gt;mix: MixConfig (可选)&lt;br&gt;  (gain_db, ducking 配置)&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F3E5F5;fontColor=#333;strokeColor=#C119C4;align=left;spacingLeft=8;verticalAlign=top;spacingTop=5;" vertex="1" parent="1">
          <mxGeometry x="1130" y="295" width="220" height="75" as="geometry"/>
        </mxCell>

        <!-- TimelineTracks 到子轨的箭头 -->
        <mxCell id="tl-arr1" style="strokeColor=#D208C1;strokeWidth=1.5;dashed=1;exitX=1;exitY=0.3;entryX=0;entryY=0.5;" edge="1" parent="1" source="m-tl-b" target="m-ct-b"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="tl-arr2" style="strokeColor=#D208C1;strokeWidth=1.5;dashed=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="m-tl-b" target="m-st-b"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="tl-arr3" style="strokeColor=#D208C1;strokeWidth=1.5;dashed=1;exitX=1;exitY=0.7;entryX=0;entryY=0.5;" edge="1" parent="1" source="m-tl-b" target="m-vt-b"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- ====== 第三行: 基础模型 ====== -->
        <mxCell id="row3-label" value="&lt;b&gt;基础模型&lt;/b&gt;: 被上层模型引用的通用数据结构" style="text;html=1;fontSize=10;fontColor=#666;align=left;" vertex="1" parent="1">
          <mxGeometry x="30" y="415" width="500" height="20" as="geometry"/>
